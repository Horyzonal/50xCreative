local function chatPlaceholder(o: item) :: object:
	set {_t} to text component from (name of {_o} ? {_o})
	set hover event of {_t} to hover event showing {_o}
	return merge components ("[", {_t}, "]")

###
import:
    com.ibm.icu.text.SpoofChecker
    com.ibm.icu.text.SpoofChecker$Builder as SpoofCheckerBuilder

on script load:
    # Build once, reuse — it's expensive to construct
    set {spoof::checker} to new SpoofCheckerBuilder().build()

function normalizedText(text: text) :: text:
    return {spoof::checker}.getSkeleton(0, {_text})
###

on load:
	set {ChatSymbols::*} to ":skull:đ☠", ":sword:đ🗡", ":swords:đ⚔", ":pickaxe:đ⛏", ":crossbow:đ🏹", ":rod:đ🎣", ":fire:đ🔥", ":sob:đ😭", ":heart:đ❤", ":star:đ⭐", ":check:đ✔", ":x:đ✖", ":crown:đ👑", ":diamond:đ💎", ":coin:đ🪙", ":shield:đ🛡", ":bow:đ🏹", ":axe:đ🪓", ":hammer:đ🔨", ":wrench:đ🔧", ":gem:đ💠", ":potion:đ🧪", ":book:đ📖", ":scroll:đ📜", ":key:đ🔑", ":chest:đ📦", ":trophy:đ🏆", ":medal:đ🏅", ":flag:đ🚩", ":warning:đ⚠", ":lightning:đ⚡", ":snowflake:đ❄", ":leaf:đ🍃", ":rock:đ🪨", ":water:đ💧", ":wind:đ💨", ":boom:đ💥", ":spark:đ✨", ":dizzy:đ💫", ":comet:đ☄", ":sun:đ☀", ":moon:đ🌙", ":cloud:đ☁", ":rain:đ🌧", ":thunder:đ⛈", ":eye:đ👁", ":hand:đ✋", ":fist:đ✊", ":point:đ👉", ":up:đ⬆", ":down:đ⬇", ":left:đ⬅", ":right:đ➡", ":arrow:đ➔", ":target:đ🎯", ":crosshair:đ⊕", ":plus:đ➕", ":minus:đ➖", ":multiply:đ✖", ":divide:đ➗", ":infinity:đ∞", ":skull2:đ💀", ":ghost:đ👻", ":alien:đ👽", ":robot:đ🤖", ":dragon:đ🐉", ":unicorn:đ🦄", ":phoenix:đ🔥🦅", ":anchor:đ⚓", ":gear:đ⚙", ":hourglass:đ⌛", ":clock:đ🕐", ":bomb:đ💣", ":syringe:đ💉", ":pill:đ💊", ":bandage:đ🩹", ":magic:đ🪄", ":crystal:đ🔮", ":compass:đ🧭", ":map:đ🗺", ":backpack:đ🎒", ":tent:đ⛺", ":campfire:đ🏕", ":mountain:đ⛰", ":volcano:đ🌋", ":island:đ🏝", ":desert:đ🏜", ":tableflip:đ(╯°□°)╯︵ ┻━┻"
# CHAT
on chat:
	event isn't cancelled
	cancel event
	isPlotChatting(player) isn't true
	player's world is world "honey":
		stop
	# Slur Filter
	replace all "nigger", "n1gger", "nigga", "n1gga", "ngger" with "Ice Person" in message
	replace all "slut" with "flirtatious" in message

	# Chat Symbols
	loop {ChatSymbols::*}:
		set {_symbol::*} to loop-value split at "đ"
		replace all {_symbol::1} with {_symbol::2} in message

	# Chat Filters
	set message to chatEvent(player, message)

	# Chat Games
	loop indices of {cgames::ans::*}:
		set {_gameId} to loop-value
		if message = "%{cgames::ans::%{_gameId}%}%" or "baha blast":
			{cgames::ans::%{_gameId}%} and {cgames::now::%{_gameId}%} is set
			play sound "block.note_block.pling" at pitch 2 for all players
			broadcast "%nl%%{cgpref}%%nl%<#47FFF8>&l| &b%player% &fwon in &3%time since {cgames::now::%{_gameId}%}% &fand received &a$10&f!%nl%<#47FFF8>&l| &fThe answer was &f%{cgames::ans::%{_gameId}%}%!%nl%"
			delete {cgames::ans::%{_gameId}%} and {cgames::now::%{_gameId}%}
			add 1 to {ChatGameWins::%player's uuid%}
			add 10 to {cash::%player's uuid%}
			stop


	# Mute Chat
	{mutechat} is set:
		player doesn't have permission "staff.mutechat"
		send "{@warn} Chat is currently muted."
		sfx(player, "fail")
		stop

	{supermutechat} is set:
		player isn't in operators
		send "{@warn} Chat is currently muted."
		sfx(player, "fail")
		stop

	# Chat Format
	set message to formatted message
	set message to uncolored message if priority(player) < 2
	set message to unformatted message if priority(player) < 3

	# Admin Chat
	player has metadata "adminchat":
		adminchat(player, message)
		stop

	# Staff Chat
	player has metadata "staffchat":
		staffchat(player, message)
		stop

	# Donor Chat
	player has metadata "donorchat":
		donorchat(player, message)
		stop

	priority(player) < 10:
		message contains "nigger", "n1gger", "nigga", "n1gga", "ngger", "ngga", "nga":
			stop
		# Broken!!!!
###
		message matches "(https:\/\/www\.|http:\/\/www\.|https:\/\/|http:\/\/)?[a-zA-Z0-9]{2,}(\.[a-zA-Z0-9]{2,})(\.[a-zA-Z0-9]{2,})?":
			send "{@warn} You may not advertise."
			stop
###
		message contains "/join" or "minehut.gg" or "minehut gg":
			send "{@warn} You may not advertise."
			stop	
		formatted message = "":
			send "{@warn} Your message must contain something!"
			stop
		player's metadata "chat_cooldown" is set:
			send "{@warn} You may chat again in %1 rl second - time since player's metadata "chat_cooldown"%."
			stop

	# Chat Ping
	loop all players where [input != player]:
		unformatted message contains "%loop-player%"
		{s::ping::%loop-player's uuid%} isn't set
		loop-player's metadata "vanished" isn't set
		set {_ping} to minimessage from "<reset><gradient:#FFA760:#FFE760>@%loop-player%<reset>"
		replace all "%loop-player%" with "%{_ping}%%{cf::%player's uuid%} ? "<#DEDEDE>"%" in message
		send action bar "{@info} <#75C9FF>%player% &fhas pinged you!" to loop-player
		play sound "block.note_block.pling" at pitch 1.8 for loop-player

	# Chat Color / Gradient
	length of raw {cf::%player's uuid%} > 2:
		set message to minimessage from "%{cf::%player's uuid%} ? "<#E0E0E0>"%%message%"
	else:
		set message to "%{cf::%player's uuid%} ? "<#E0E0E0>"%%message%"
 
	set {_format} to text component from "%player's prefix%%toHex({nick::%player's uuid%}) ? player%&f%player's suffix% <#6E6E6E>» <#E0E0E0>%toHex(message)%"

	# Tooltip Hover Event
	set {_x::1} to "<#0079FF>&m                                         "
	set {_x::2} to "<#16AFFF>&l%player%"
	set {_x::3} to "<#DDDDDD>Their current statistics."
	set {_x::4} to ""
	set {_x::5} to "<#16E3FF>| <#00FF73>💲 &fᴍᴏɴᴇʏ &7→ <#00FF73>%numFormat({cash::%player's uuid%})%"
	set {_x::6} to "<#16E3FF>| <#FFE300>⚛ &fᴋᴀʀᴍᴀ &7→ <#FFE300>%numFormat({karma::%player's uuid%})%"
	set {_x::7} to "<#16E3FF>| <#FF49DD>⏳ &fᴛɪᴍᴇ &7→ <#FF49DD>%timeFormat2(player's time played)%"
	set {_x::8} to "<#16E3FF>| <#DA2FFF>👤 &fᴊᴏɪɴᴇᴅ &7→ <#DA2FFF>%timeFormat2(time since player's first login)% ᴀɢᴏ"
	set {_x::9} to ""
	set {_x::10} to "&7(Click to message %player%)"
	set {_x::11} to "<#0079FF>&m                                         "
	add hover event showing (text component from (join {_x::*} with nl)) to {_format}
	add click event to suggest command "/msg %player% " to {_format}
	
	# Show Items
	"%{_format}%" contains "[item]" or "hand":
		component replace "\[item]" and "\[hand]" with chatPlaceholder(player's tool) in {_format}

	"%{_format}%" contains "[offhand]":
		component replace "\[offhand]" with chatPlaceholder(player's offhand tool) in {_format}

	"%{_format}%" contains "[helmet]":
		component replace "\[helmet]" with chatPlaceholder(player's helmet) in {_format}
	
	"%{_format}%" contains "[chestplate]":
		component replace "\[chestplate]" with chatPlaceholder(player's chestplate) in {_format}
	
	"%{_format}%" contains "[leggings]":
		component replace "\[leggings]" with chatPlaceholder(player's leggings) in {_format}

	"%{_format}%" contains "[boots]":
		component replace "\[boots]" with chatPlaceholder(player's boots) in {_format}

	"%{_format}%" contains "[inv]":
		set {_e} to player
		set {_t} to text component from "%player%'s Inventory"
		set hover event of {_t} to hover event showing "&aClick &fto see their inventory!"
		create callback for {_t} with -1 uses:
			create a gui with virtual chest inventory with 4 rows named "%{_e}%'s Inventory":
				loop 36 times:
					make gui slot (loop-value - 1) with slot (loop-value - 1) of {_e}'s inventory
			set lock status of last gui to true
			open the last gui for player
		component replace "\[inv]" with merge components ("[", {_t}, "]") in {_format}
	set {_format} to merge components (minimessage from "<head:%player%:true> ") and {_format}
	send component {_format} to console and all players where [{Ignored.Players::%input's uuid%::*} doesn't contain player]
	DCChatLog(player, message)
	priority(player) = 1
	set player's metadata "chat_cooldown" to now
	wait 1 second
	clear player's metadata "chat_cooldown"

# ================================================================================================================================================================= #

# DEATH MESSAGES

local function showAttackerTool(o: item) :: object:
	set {_t} to text component from (name of {_o} ? {_o})
	set hover event of {_t} to hover event showing {_o}
	return {_t}

on death of player:
	set death message to ""
	if attacker is a player:
		victim is a player
		set {_format} to text component from "&4☠ &8→ &c%victim% <reset>was %"shot" if projectile is set else "slain"% by &c%attacker% &8[&c%attacker's health%♥&8] &rusing &8[&6<BLUH>&8]"
		component replace "<BLUH>" with showAttackerTool(attacker's tool) ? "Bare hands" in {_format}
		broadcast component {_format}
		stop
	broadcast "&4☠ &8→ &c%victim%&f thought they were in Creative Mode." if damage was caused by fall
	broadcast "&4☠ &8→ &c%victim% &fswam in orange juice." if damage was caused by lava
	broadcast "&4☠ &8→ &c%victim% &fwas too lit to live." if damage was caused by burning
	broadcast "&4☠ &8→ &c%victim% &fnever learned how to swim." if damage was caused by drown
	broadcast "&4☠ &8→ &c%victim% &fforgot how to use the microwave." if damage was caused by starvation
	broadcast "&4☠ &8→ &c%victim% &flied to God." if damage was caused by lightning
	broadcast "&4☠ &8→ &c%victim% &fgot too close to an explosion." if damage was caused by block explosion
	broadcast "&4☠ &8→ &c%victim% &fsat on a prickle." if damage was caused by contact
	broadcast "&4☠ &8→ &c%victim% &fforgot how to breathe." if damage was caused by suffocation
	broadcast "&4☠ &8→ &c%victim% &fsweat to death."  if damage was caused by melting
	broadcast "&4☠ &8→ &c%victim% &fwanted to find Jesus."  if damage was caused by suicide
	broadcast "&4☠ &8→ &c%victim% &ffell in the void." if damage was caused by void
	broadcast "&4☠ &8→ &c%victim% &ftried the tide pod challenge." if damage was caused by poison
	broadcast "&4☠ &8→ &c%victim% &fwithered away..." if damage was caused by wither
	broadcast "&4☠ &8→ &c%victim% &fwas crushed by a block because it wanted love." if damage was caused by falling block
	broadcast "&4☠ &8→ &c%victim% &fdidn't see a block."  if damage was caused by hitting wall while flying
	broadcast "&4☠ &8→ &c%victim% &fcan't handle the crowd of labubu fans." if damage was caused by cramming
	broadcast "&4☠ &8→ &c%victim% &fmagically vaporized into nothingness." if damage was caused by kill
	keep the inventory and experiences
	cancel drops
	force victim to respawn
	wait 1 tick
	spawn(victim, "lobby")

# ================================================================================================================================================================= #

# EVENTS
on command "lp", "perm", "perms", "permission", "permissions" or "luckperms":
	priority(sender) >= 13
	loop all players:
		clear team of loop-player
		rankPlayer(loop-player)
		wait 1 tick

# INV SOUND EFFECTS
on tool change:
	{s::invsfx::%player's uuid%} isn't set
	play sound "block.note_block.hat" at volume 0.1 at pitch 1.6 for event-player

on inventory slot change:
	{s::invsfx::%player's uuid%} isn't set
	play sound "block.note_block.hat" at volume 0.1 at pitch 2 for event-player

on inventory click:
	{s::invsfx::%player's uuid%} isn't set
	play sound "block.note_block.hat" at volume 0.1 at pitch 2 for event-player

on inventory drag:
	{s::invsfx::%player's uuid%} isn't set
	play sound "block.note_block.hat" at volume 0.1 at pitch 2 for event-player

on walk on yellow carpet:
	event-world = "lobby"
	push player upwards at speed 1
	wait 2 tick
	push player forward at speed 5
	play sound "entity.firework_rocket.launch" to player
	
on swap item:
	event-world = "lobby"
	priority(event-player) < 12
	cancel event

on player drop:
	event-world = "lobby"
	priority(event-player) < 12
	cancel event

on player pickup:
	event-world = "lobby"
	priority(event-player) < 12
	cancel event

on player inventory click:
	event-world = "lobby"
	priority(event-player) < 12
	cancel event

on region enter:
	if region is "EnterStaffRoom":
		teleport event-player to {staffentwarnoom}

# CANVAS

on place:
	event-world = "canvas"
	event-block isn't solid
	cancel event
	send "{@warn} Blocks must be solid." to player
	
on dispense:
	event-world = "canvas"
	cancel event

on flow:
	event-world != "plots"
	getAllowedWorlds() doesn't contain event-world
	cancel event

# VOTING

on vote:
	username of event-vote parsed as offlineplayer has played before
	send "{@name} &8| &a%username of event-vote% &fjust voted and received &a1x Voting Crate Key&f!" to all players
	add 1 to {vkey::%username of event-vote parsed as offlineplayer's uuid%}

# ============ #
# ENTITY LIMIT #
# ============ #

on player drop:
	getAllowedWorlds() doesn't contain event-world
	delete event-dropped item

every tick:
	set {_d::*} to dropped items where [getAllowedWorlds() doesn't contain input's world]
	set {_d::*} to {_d::*} where [input isn't Invulnerable]
	kill {_d::*}

on mine:
	getAllowedWorlds() doesn't contain event-world
	clear drops

on break:
	getAllowedWorlds() doesn't contain event-world
	clear drops

on portal:
	cancel event

on portal enter:
	cancel event
	
on portal create:
	cancel event

on rightclick with ender pearl:
	reset item cooldown of player's tool for player

on place of end portal frame:
	set event-block to end portal frame

on shoot:
	getAllowedWorlds() doesn't contain event-world
	wait 10 second
	metadata "yes" of event-projectile isn't true
	kill event-projectile
    
on shoot:
	getAllowedWorlds() doesn't contain event-world
	event-projectile is thrown potion
	cancel event

# NBT TYPE SHIT

on spawn:
	event-spawnreason = mob spawner:
		cancel event
	event-entity is an area effect cloud:
		entity isn't invulnerable
		cancel event
	"%nbt compound of event-entity%" contains "attribute_modifiers":
		event-world = "creative"
		cancel event
	"%nbt compound of event-entity%" contains "Invisible:1b":
		event-entity != item frame or glow item frame:
			cancel event

	event-world = "creative":
		set {_entities::*} to all entities in world "creative" where [input isn't a player, item frame, glow item frame, or painting]
		set {_entities::*} to {_entities::*} where [input isn't invulnerable]
		set {_x} to number of {_entities::*}
		{_x} > 200:
			kill {_entities::*}
			stafflog("&fCleared all entities in creative. &7(%{_x}%)")
		

on dispense:
	"%nbt compound of event-block%" contains "attribute_modifiers", "run_command" or "play_sound"
	cancel event

on player tool change:
	priority(event-player) < 4
	"%nbt compound of event-player's tool%" contains "attribute_modifiers", "run_command" or "play_sound"
	set event-player's tool to air

on player inventory slot change:
	priority(event-player) < 4
	"%nbt compound of event-player's tool%" contains "attribute_modifiers", "run_command" or "play_sound"
	set event-player's tool to air

on swap hand items:
	priority(event-player) < 4
	"%nbt compound of event-player's tool%" contains "attribute_modifiers", "run_command" or "play_sound"
	set event-player's tool to air

on vehicle create:
	event-world != {@supported_worlds}:
		cancel event
	else:
		{el::%name of event-world%} < 100:
			add 1 to {el::%name of event-world%}
		else:
			set {el::%name of event-world%} to 0
			kill all boats and minecarts in event-world

on vehicle destroy:
	event-world = "creative" or "donor"
	remove 1 from {el::%name of event-world%}

on player egg throw:
	set the hatching number to 0

on explode:
	event-world != "event"
	event-entity isn't wind charge or tnt
	cancel event

on explode:
	event-entity is tnt
	cancel event
#	create safe explosion of force 3 at event-location

on firework explode:
	kill event-entity

on book edit:
    page 50 of event-item is set
    cancel event
    send "You can't write book with more than 49 pages"

on player start spectating:
	event.getPlayer().getSpectatorTarget().hasPermission("staff.chat")
	player doesn't have permission "staff.chat"
	cancel event

on player swap spectating of player:
	event.getPlayer().getSpectatorTarget().hasPermission("staff.chat")
	player doesn't have permission "staff.chat"
	cancel event

on teleport:
	"%event-teleportcause%" is "spectate"
	event.getPlayer().getSpectatorTarget().hasPermission("staff.chat")
	player doesn't have permission "staff.chat"
	cancel event

on rightclick with goat horn:
	player doesn't have permission "staff.chat"
	cancel event
###
import:
	com.plotsquared.core.PlotAPI
	com.plotsquared.core.player.PlotPlayer
	com.plotsquared.core.location.Location
	org.bukkit.event.player.PlayerInteractEvent
	org.bukkit.event.block.Action

on PlayerInteractEvent:
	event.getPlayer().getName() = "siqns"
	send 1 to player("siqns")
	event.getAction() = Action.LEFT_CLICK_BLOCK
	send 2 to player("siqns")
	event.getPlayer() doesn't have permission "staff.chat"
	send 3 to player("siqns")
	event.getPlayer().hasPermission("fawe.permpack.basic")
	send 4 to player("siqns")
	event.getPlayer().getLocation().isPlotRoad()
	send 5 to player("siqns")
	event.setCancelled(true)
