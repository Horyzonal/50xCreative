# CHAT GAMES

on load:
	loop indices of {cgames::now::*}:
		if difference between {cgames::now::%loop-value%} and now > 1 minute:
			delete {cgames::ans::%loop-value%} and {cgames::now::%loop-value%}
	set {cgpref} to "%minimessage from "<b><gradient:#47FFF8:#0098FF>CHAT GAMES"%"
	set {typeout::*} to "adrenocorticotropin", "adrenocorticotrophin", "anthropomorphization", "anthropomorphisation", "antidisestablishmentarianism", "antixerophthalmic", "autothaumaturgist", "canaliculodacryocystorhinostomy", "chargoggagoggmanchauggagoggchaubunagungamaugg", "cholangiopancreatography", "convolvulaceous", "corticopontocerebellar", "counterimmunoelectrophoresis", "dehydrothiotoluidine", "dextrodeorsumversion", "erythrocytapheresis", "ferriprotoporphyrin", "floccinaucinihilipilification", "gastroenterologist", "gegenstandstheorie", "hexakosioihexekontahexaphobia", "hippopotomonstrosesquippedaliophobia", "hippopotomonstrosesquipedaliophobia", "honorificabilitudinity", "honourificabilitudinity", "laryngotracheobronchitis", "oligonucleotide", "otorhinolaryngological", "parallelogrammatic", "photoplethysmography", "pneumoencephalography", "pneumonoultramicroscopicsilicovolcanoconiosis",  "polyphiloprogenitive", "pseudopseudohypoparathyroidism", "pseudorhombicuboctahedron", "psychoneuroendocrinological", "psychoneuroimmunology", "psychophysicotherapeutics", "radiometeorograph", "sclerectoiridectomy", "spectrophotofluorometry", "sphygmomanometer", "stereoelectroencephalography", "supercalifragilisticexpialidocious", "tonsillopharyngitis", and "ventriculocisternostomy"
	set {unscramble::*} to "creative", "builder", "masterpiece", "minecraft", "diamond", "pickaxe", "survival", "adventure", "overworld", "stronghold", "cobblestone", "enchant", "armor", "beacon", "slime", "piston", "shulker", "blaze", "ghast", "witch", "campfire", "lightning", "amethyst", and "emerald"

import:
    java.lang.String as JavaString

function rad_to_deg(r: number) :: number:
	return {_r} * 57.2957795130823
 
function chatGames(i: int, ov: number = 99, op: number = 99):
	{_i} < 7
	
	# Generate unique game ID
	add 1 to {cgames::id}
	set {_gameId} to {cgames::id}
	
	{_i} = 1: # Word
		set {cgames::ans::%{_gameId}%} to random element out of ({typeout::*})
		broadcast "%nl%%{cgpref}%%nl%<#47FFF8>&l| &fType out the word: <#83FFEC>%{cgames::ans::%{_gameId}%}%%nl%<#47FFF8>&l| &fWinner gets rewarded with &acash&f!%nl%"
 
	{_i} = 2: # Unscramble
		set {cgames::ans::%{_gameId}%} to random element out of ({unscramble::*})
		broadcast "%nl%%{cgpref}%%nl%<#47FFF8>&l| &fUnscramble the word: <#83FFEC>%join (shuffled (split {cgames::ans::%{_gameId}%} at "")) with ""%%nl%<#47FFF8>&l| &fWinner gets rewarded with &acash&f!%nl%"
	
	{_i} = 3: # Math
		set {_x} to random integer between 1 and 7 if {_ov} is 99 else {_ov}
		{_x} = 1:
			set {_a} to random integer between 1 and 50
			set {_b} to random integer between 1 and 50
			set {_o} to "%{_a}% + %{_b}%"
			set {cgames::ans::%{_gameId}%} to {_a} + {_b}
		{_x} = 2:
			set {_a} to random integer between 1 and 50
			set {_b} to random integer between 1 and 50
			set {_o} to "%{_a}% - %{_b}%"
			set {cgames::ans::%{_gameId}%} to {_a} - {_b}
		{_x} = 3:
			set {_a} to random integer between 1 and 12
			set {_b} to random integer between 1 and 12
			set {_o} to "%{_a}% x %{_b}%"
			set {cgames::ans::%{_gameId}%} to {_a} * {_b}
		{_x} = 4:
			set {_t} to random integer between 1 and 2
			set {_a} to random integer between 1 and 5
			set {_b} to floor((random integer between 1 and 25) /{_a})*{_a}
			set {_c} to random integer between 1 and 100
			set {_o} to "%{_b}%/%{_a}%+%{_c}%" if {_t} is 1 else "%{_b}%/%{_a}%-%{_c}%"
			set {cgames::ans::%{_gameId}%} to ({_b}/{_a})+{_c} if {_t} is 1 else ({_b}/{_a})-{_c}
		{_x} = 5:
			set {_d} to (random integer between 1 and 3) if {_op} > 15 else {_op}
			set {_a} to random integer between 5 and 70
			set {_b} to random integer between 5 and 70
			
			set {_min_c} to abs({_a} - {_b}) + 1
			set {_max_c} to {_a} + {_b} - 1
			
			set {_c} to random integer between {_min_c} and {_max_c}
 
			set {_s} to ({_a} + {_b} + {_c}) / 2
			set {_Area} to sqrt({_s} * ({_s} - {_a}) * ({_s} - {_b}) * ({_s} - {_c}))
 
			set {_check} to round({_Area}, {_d})
			set {cgames::ans::%{_gameId}%} to JavaString.format("%%.%{_d}%f", {_check})
 
			add "%nl%%{cgpref}%" to {_lines::*}
			add "<#47FFF8>&l| &fUsing Heron's formula, what is the area of a triangle?" to {_lines::*}
			add "<#47FFF8>&l| &fSides: A=<#83FFEC>%{_a}%<#FFFFFF> B=<#83FFEC>%{_b}%<#FFFFFF> C=<#83FFEC>%{_c}%" to {_lines::*}
			add "<#47FFF8>&l| &fRound your answer to %{_d}% decimal place(s)." to {_lines::*}
			add "<#47FFF8>&l| &fWinner gets rewarded with &acash&f!" to {_lines::*}
		
		{_x} = 6:
			set {_d} to (random integer between 1 and 3) if {_op} > 15 else {_op}
			set {_a} to random integer between 8 and 20
			set {_b} to random integer between 8 and 20
			set {_angle_deg} to random integer between 10 and 170
 
			set {_c_squared} to ({_a} ^ 2) + ({_b} ^ 2) - (2 * {_a} * {_b} * cos({_angle_deg}))
			set {_c_side} to sqrt({_c_squared})
 
			set {_check} to round({_c_side}, {_d})
			set {cgames::ans::%{_gameId}%} to JavaString.format("%%.%{_d}%f", {_check})
 
			set {_lines::*} to "%nl%%{cgpref}%"
			add "<#47FFF8>&l| &fUsing the Law of Cosines, find the missing side (c)!" to {_lines::*}
			add "<#47FFF8>&l| &fMeasures: a=<#83FFEC>%{_a}%<#FFFFFF> b=<#83FFEC>%{_b}%<#FFFFFF> C=<#83FFEC>%{_angle_deg}%°" to {_lines::*}
			add "<#47FFF8>&l| &fRound your answer to %{_d}% decimal place(s)." to {_lines::*}
			add "<#47FFF8>&l| &fWinner gets rewarded with &acash&f!" to {_lines::*}
		
		{_x} = 7:
			set {_option} to random integer between 1 and 3
			set {_d} to (random integer between 1 and 3) if {_op} > 15 else {_op}
			set {_a} to random integer between 10 and 30
			set {_b} to random integer between 10 and 30
 
			set {_min_c} to abs({_a} - {_b}) + 1
			set {_max_c} to {_a} + {_b} - 1
			set {_c} to random integer between {_min_c} and {_max_c}
			
			if {_option} is 1:
				set {_num} to ({_b} ^ 2) + ({_c} ^ 2) - ({_a} ^ 2)
				set {_den} to 2 * {_b} * {_c}
				set {_find_angle} to "A"
			else if {_option} is 2:
				set {_num} to ({_a} ^ 2) + ({_c} ^ 2) - ({_b} ^ 2)
				set {_den} to 2 * {_a} * {_c}
				set {_find_angle} to "B"
			else:
				set {_num} to ({_a} ^ 2) + ({_b} ^ 2) - ({_c} ^ 2)
				set {_den} to 2 * {_a} * {_b}
				set {_find_angle} to "C"
 
			set {_cos_val} to {_num} / {_den}
			set {_angle_deg} to acos({_cos_val})
 
			set {_check} to round({_angle_deg}, {_d})
			set {cgames::ans::%{_gameId}%} to JavaString.format("%%.%{_d}%f", {_check})
 
			set {_lines::*} to "%nl%%{cgpref}%"
			add "<#47FFF8>&l| &fUsing the Law of Cosines, find the missing angle (%{_find_angle}%)!" to {_lines::*}
			add "<#47FFF8>&l| &fSides: a=<#83FFEC>%{_a}%<#FFFFFF> b=<#83FFEC>%{_b}%<#FFFFFF> c=<#83FFEC>%{_c}%" to {_lines::*}
			add "<#47FFF8>&l| &fRound your answer to %{_d}% decimal place(s)." to {_lines::*}
			add "<#47FFF8>&l| &fWinner gets rewarded with &acash&f!" to {_lines::*}
 
		{_x} = 8:
			set {_d} to (random integer between 1 and 3) if {_op} > 15 else {_op}
			set {_n} to random integer between 2 and 6
			set {_a_coef} to random integer between 1 and 10
			set {_lower} to random integer between 0 and 5
			set {_upper} to {_lower} + (random integer between 1 and 6)
 
			set {_result} to ({_a_coef} / ({_n} + 1)) * (({_upper} ^ ({_n} + 1)) - ({_lower} ^ ({_n} + 1)))
 
			set {_check} to round({_result}, {_d})
			set {cgames::ans::%{_gameId}%} to JavaString.format("%%.%{_d}%f", {_check})
 
			set {_lines::*} to "%nl%%{cgpref}%"
			add "<#47FFF8>&l| &fEvaluate the definite integral!" to {_lines::*}
			add "<#47FFF8>&l| &f∫ <#83FFEC>%{_a_coef}%x^%{_n}% <#FFFFFF>dx from <#83FFEC>%{_lower}% <#FFFFFF>to <#83FFEC>%{_upper}%" to {_lines::*}
			add "<#47FFF8>&l| &fRound your answer to %{_d}% decimal place(s)." to {_lines::*}
			add "<#47FFF8>&l| &fWinner gets rewarded with &acash&f!" to {_lines::*}
 
		{_x} = 9:
			set {_d} to (random integer between 1 and 3) if {_op} > 15 else {_op}
			set {_a_coef} to random integer between 1 and 8
			set {_lower_mult} to random integer between 0 and 3
			set {_upper_mult} to {_lower_mult} + (random integer between 1 and 4)
 
			set {_lower_rad} to {_lower_mult} * 3.14159265358979 / 2
			set {_upper_rad} to {_upper_mult} * 3.14159265358979 / 2
 
			set {_result} to {_a_coef} * ((-1 * cos(rad_to_deg({_upper_rad}))) + cos(rad_to_deg({_lower_rad})))
 
			set {_check} to round({_result}, {_d})
			set {cgames::ans::%{_gameId}%} to JavaString.format("%%.%{_d}%f", {_check})
 
			set {_lower_label} to "%{_lower_mult}%π/2" if {_lower_mult} > 0 else "0"
			set {_upper_label} to "%{_upper_mult}%π/2"
 
			set {_lines::*} to "%nl%%{cgpref}%"
			add "<#47FFF8>&l| &fEvaluate the definite integral!" to {_lines::*}
			add "<#47FFF8>&l| &f∫ <#83FFEC>%{_a_coef}%sin(x) <#FFFFFF>dx from <#83FFEC>%{_lower_label}% <#FFFFFF>to <#83FFEC>%{_upper_label}%" to {_lines::*}
			add "<#47FFF8>&l| &fRound your answer to %{_d}% decimal place(s)." to {_lines::*}
			add "<#47FFF8>&l| &fWinner gets rewarded with &acash&f!" to {_lines::*}
 
		{_x} = 10:
			set {_d} to (random integer between 2 and 4) if {_op} > 15 else {_op}
 
			set {_a_coef} to random integer between 1 and 5
			set {_b_coef} to random integer between 1 and 10
			set {_n} to random integer between 3 and 7
 
			set {_sigma} to 0
			loop {_n} times:
				set {_i} to loop-number
				set {_sigma} to {_sigma} + (({_a_coef} * ({_i} ^ 2)) + {_b_coef})
 
			set {_c_coef} to random integer between 1 and 4
			set {_m} to random integer between 2 and 5
 
			set {_product} to 1
			loop {_m} times:
				set {_i} to loop-number
				set {_product} to {_product} * ({_c_coef} + {_i})
 
			set {_final} to 0.5 * ({_product} ^ 2) * sin({_sigma})
 
			set {_check} to round({_final}, {_d})
			set {cgames::ans::%{_gameId}%} to JavaString.format("%%.%{_d}%f", {_check})
 
			set {_lines::*} to "%nl%%{cgpref}%"
			add "<#47FFF8>&l| &c&lGetting Productive" to {_lines::*}
			add "<#47FFF8>&l| &f&lStep A: &fEvaluate the Sigma:" to {_lines::*}
			add "<#47FFF8>&l|   &f Σ (<#83FFEC>%{_a_coef}%i² + %{_b_coef}%<#FFFFFF>) &ffrom i=<#83FFEC>1 <#FFFFFF>to <#83FFEC>%{_n}%" to {_lines::*}
			add "<#47FFF8>&l|   &7→ Use this as angle θ (in degrees)" to {_lines::*}
			add "<#47FFF8>&l| &f&lStep B: &fEvaluate the Product:" to {_lines::*}
			add "<#47FFF8>&l|   &f Π (<#83FFEC>%{_c_coef}% + i<#FFFFFF>) &ffrom i=<#83FFEC>1 <#FFFFFF>to <#83FFEC>%{_m}%" to {_lines::*}
			add "<#47FFF8>&l|   &7→ Use this as hypotenuse h" to {_lines::*}
			add "<#47FFF8>&l| &f&lFinal: &fFind the area of the isosceles triangle:" to {_lines::*}
			add "<#47FFF8>&l|   &fA = ½ · h² · sin(θ)" to {_lines::*}
			add "<#47FFF8>&l| &fRound your answer to %{_d}% decimal place(s)." to {_lines::*}
			add "<#47FFF8>&l| &fWinner gets rewarded with &acash&f!" to {_lines::*}
 
		{_x} = 11:
			set {_d} to (random integer between 2 and 4) if {_op} > 15 else {_op}
 
			set {_a_coef} to random integer between 1 and 4
			set {_b_coef} to random integer between 1 and 6
			set {_n} to random integer between 3 and 6
 
			set {_sigma} to 0
			loop {_n} times:
				set {_i} to loop-number
				set {_sigma} to {_sigma} + (({_a_coef} * ({_i} ^ 3)) - ({_b_coef} * {_i}))
 
			set {_p_coef} to random integer between 2 and 6
			set {_e_exp} to random integer between 3 and 5
			set {_derivative_val} to {_p_coef} * {_e_exp} * ({_sigma} ^ ({_e_exp} - 1))
 
			set {_b_imag} to random integer between 5 and 30
			set {_modulus} to sqrt(({_derivative_val} ^ 2) + ({_b_imag} ^ 2))
 
			set {_int_div} to random integer between 2 and 4
			set {_upper_rad} to 3.14159265358979 / {_int_div}
 
			set {_final} to {_modulus} * sin(rad_to_deg({_upper_rad}))
 
			set {_check} to round({_final}, {_d})
			set {cgames::ans::%{_gameId}%} to JavaString.format("%%.%{_d}%f", {_check})
 
			set {_lines::*} to "%nl%%{cgpref}%"
			add "<#47FFF8>&l| &4&lChain Reaction" to {_lines::*}
			add "<#47FFF8>&l| &f&lStep A: &fEvaluate the Sigma (result = k):" to {_lines::*}
			add "<#47FFF8>&l|   &f Σ (<#83FFEC>%{_a_coef}%i³ - %{_b_coef}%i<#FFFFFF>) &ffrom i=<#83FFEC>1 <#FFFFFF>to <#83FFEC>%{_n}%" to {_lines::*}
			add "<#47FFF8>&l| &f&lStep B: &fDifferentiate, then evaluate at x=k:" to {_lines::*}
			add "<#47FFF8>&l|   &ff(x) = <#83FFEC>%{_p_coef}%x^%{_e_exp}%  <#FFFFFF>→ find <#83FFEC>f'(k)" to {_lines::*}
			add "<#47FFF8>&l|   &7→ Call this result r" to {_lines::*}
			add "<#47FFF8>&l| &f&lStep C: &fFind the modulus of complex number z:" to {_lines::*}
			add "<#47FFF8>&l|   &fz = r + <#83FFEC>%{_b_imag}%<#FFFFFF>i  →  |z| = √(r² + %{_b_imag}%²)" to {_lines::*}
			add "<#47FFF8>&l|   &7→ Call this result m" to {_lines::*}
			add "<#47FFF8>&l| &f&lFinal: &fEvaluate the definite integral:" to {_lines::*}
			add "<#47FFF8>&l|   &f∫ <#83FFEC>m·cos(x) <#FFFFFF>dx from <#83FFEC>0 <#FFFFFF>to <#83FFEC>π/%{_int_div}%" to {_lines::*}
			add "<#47FFF8>&l| &fRound your answer to %{_d}% decimal place(s)." to {_lines::*}
			add "<#47FFF8>&l| &fWinner gets rewarded with &acash&f!" to {_lines::*}
		
		if {_x} < 5:
			broadcast "%nl%%{cgpref}%%nl%<#47FFF8>&l| &fSomeone quickly solve what is <#83FFEC>%{_o}%%nl%<#47FFF8>&l| &fWinner gets rewarded with &acash&f!%nl%"
		else:
			broadcast components (merge components {_lines::*} joined with newline) and nl
 
	set {cgames::now::%{_gameId}%} to now
	play sound "block.note_block.pling", "block.note_block.bit", "block.note_block.chime" at volume 2 for all players
	wait 1 minute
	{cgames::ans::%{_gameId}%} is set
	broadcast "%nl%%{cgpref}%%nl%<#47FFF8>&l| &7No one solved the chat game.%nl%<#47FFF8>&l| &7The answer was: <#83FFEC>%{cgames::ans::%{_gameId}%}%%nl%"
	play sound "block.note_block.pling" at pitch 0.1 for all players
	delete {cgames::ans::%{_gameId}%} and {cgames::now::%{_gameId}%}


# ================================================================================================================================================================= #

on load:
	set {-tab} to objective with id "ping" with criteria "dummy" named "ping" with render type integer with display slot player_list
	
	create section stored in {-header}:
		set {_h::1} to minimessage from "<gradient:#003BFF:#0079FF:#003BFF><st>┏%" " repeated 70 time%</st>┓"
		set {_h::2} to ""
		set {_h::3} to {-anim}
		set {_h::4} to minimessage from "<gradient:#CBCBCB:#FFFFFF:#CBCBCB>ᴛʜᴇ </gradient><gradient:#3FD8FF:#ABFCFF>ᴘʀᴇᴍɪᴜᴍ </gradient>ᴄʀᴇᴀᴛɪᴠᴇ ᴇxᴘᴇʀɪᴇɴᴄᴇ"
		set {_h::5} to ""
		set all players's tablist header to (join {_h::*} with nl)

every tick:
	set title of (all players where [isInRegion(input) isn't true])'s fastboard to "%{-anim}%"
	run section {-header} async

import:
	org.bukkit.Statistic

every second:
	set {_highlight} to "<shadow:#000000AA>"
	loop all players:

		# SCOREBOARD
		if isInRegion(loop-player) isn't true:
			set title of loop-player's fastboard to minimessage from "%{_highlight}%<b><gradient:#1685FF:#16E3FF>50xCreative"
			set line 1 of loop-player's fastboard to minimessage from "%{_highlight}%<st><gradient:#003BFF:#0079FF:#003BFF>•                             •"
			set line 2 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF><b>ᴘʟᴀʏᴇʀ"
			set line 3 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#00FF73>💲 <white>ᴍᴏɴᴇʏ <gray>→ <#00FF73>%numFormat({cash::%loop-player's uuid%})%"
			set line 4 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#FFE300>⚛ <white>ᴋᴀʀᴍᴀ <gray>→ <#FFE300>%numFormat({karma::%loop-player's uuid%})%"
			set line 5 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#FF7C00>█ <white>ᴘʟᴏᴛs <gray>→ <#FF7C00>%loop-player's claimed plots%/%loop-player's max plots%"
			set line 6 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#FF4949>🪓 <white>ᴡᴀɴᴅ <gray>→ <#FF4949>soon!"
			set line 7 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#FF49DD>⏳ <white>ᴛɪᴍᴇ <gray>→ <#FF49DD>%timeFormat2(loop-player's time played)%"
			set line 8 of loop-player's fastboard to ""
			set line 9 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF><b>sᴇʀᴠᴇʀ"
			set line 10 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#66CAFF>⏲ <white>ᴛᴘs <gray>→ <#8BD7FF>%spark tps%"
			set line 11 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#66CAFF>🗄 <white>ᴍsᴘᴛ <gray>→ <#8BD7FF>%spark mspt%"
			set line 12 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>| <#66CAFF>⚡ <white>ʟᴏᴀᴅ <gray>→ <#8BD7FF>%spark cpu%%%"
			set line 13 of loop-player's fastboard to ""
			set line 14 of loop-player's fastboard to minimessage from "%{_highlight}%<#16AFFF>⛏ <#DEDEDE>50xCreative.fun"
			set line 15 of loop-player's fastboard to minimessage from "%{_highlight}%<st><gradient:#003BFF:#0079FF:#003BFF>•                             •"

		set {_val} to (loop-player's ping/500) if loop-player's ping < 500 else 1
		set {_pingAmount} to loop-player's ping
		if loop-player's name is "Kundaliel":
			set {_val} to 0
			set {_pingAmount} to 0
		set number format of {-tab} for loop-player to minimessage from "<transition:#27FF4F:#FDFF5A:#FF4141:%{_val}%>%{_pingAmount}%ᴍs"

		# TABLIST NAME
		set {_tabname::1} to " %logo(name of loop-player's world)%&f "
		set {_tabname::2} to loop-player's prefix
		set {_tabname::3} to "%shorten(toHex({nick::%loop-player's uuid%})) ? loop-player%&r"
		set {_tabname::4} to loop-player's suffix
		set {_tabname::5} to loop-player's staff status
		set {_tabname::6} to loop-player's dc status
		set {_tabname::7} to loop-player's vanish status
		set {_tabname::8} to loop-player's afk status
		set loop-player's tablist name to concat({_tabname::*})

		# FOOTER
		set {_f::1} to ""
		set {_f::2} to "&fᴡᴏʀʟᴅ: <#16AFFF>%smallcaps(name of loop-player's world)% &7(%realPlayers(name of loop-player's world)%) &8- &fᴏɴʟɪɴᴇ: <#16AFFF>%realPlayers()% &8- &fꜱᴛᴀꜰꜰ: <#16AFFF>%realStaff()%"
		set {_f::3} to "<#DEDEDE>ᴅᴀᴛᴇ: <#16E3FF>%smallcaps(now formatted as "EEE, dd MMM")% &8⋆ <#DEDEDE>ᴛɪᴍᴇ: <#16E3FF>%capitalised now formatted as "h:mm a"% &8⋆ <#DEDEDE>ᴜᴘᴛɪᴍᴇ: <#16E3FF>%timeFormat2(uptime)%"
		set {_f::4} to ""
		set {_f::5} to "&750xCreative.fun"
		set {_f::6} to ""
		set {_f::7} to minimessage from "<gradient:#003BFF:#0079FF:#003BFF><st>┗%" " repeated 70 time%</st>┛"
		set loop-player's tablist footer to (join {_f::*} with nl)

