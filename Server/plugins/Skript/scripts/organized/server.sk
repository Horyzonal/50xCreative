import:
	de.myzelyam.api.vanish.PlayerHideEvent
	de.myzelyam.api.vanish.PlayerShowEvent

local function joinQuitMessage(p: player, s: string):
	{_s} = "new":
		broadcast "&8[<#16AFFF>➕&8] &fWelcome <#16E3FF>%{_p}% &fto {@name} &8(<#7EF0FF>#%size of all offline players%&8)"
		post "## :partying_face: `%{_p}%` has joined the server for the first time! `(#%size of all offline players%)`" to text channel with id "1417472418217197679" with bot bot "50xCreative"
	{_s} = "join":
		set {_m} to random element out of ("&7<#4BFFA0>%{_p}%&7 joined the server.", "&7Welcome back, <#4BFFA0>%{_p}%&7.", "<#4BFFA0>%{_p}%&7 has returned.", "<#4BFFA0>%{_p}%&7 has entered.", "&7Here comes <#4BFFA0>%{_p}%&7.", "&7Guess who's back? <#4BFFA0>%{_p}%&7!", "&7<#4BFFA0>%{_p}%&7 rejoined.", "&7<#4BFFA0>%{_p}%&7 just logged in.", "&7<#4BFFA0>%{_p}%&7 has reconnected.")
		broadcast "&8[<#00D263>➕&8] <#49FF9F>%{_m}%"
		post ":arrow_right: `%{_p}%` has joined." to text channel with id "1417472418217197679" with bot bot "50xCreative"
	{_s} = "quit":
		set {_m} to random element out of ("&7<#FF5050>%{_p}%&7 has left.", "&7Farewell, <#FF5050>%{_p}%&7.", "&7<#FF5050>%{_p}%&7 disconnected.", "&7Goodbye, <#FF5050>%{_p}%&7.", "&7<#FF5050>%{_p}%&7 logged out.", "&7Safe travels, <#FF5050>%{_p}%&7.", "&7See you next time, <#FF5050>%{_p}%&7.")
		broadcast "&8[<#D20000>➖&8] <#FF5050>%{_m}%"
		post ":arrow_left: `%{_p}%` has left." to text channel with id "1417472418217197679" with bot bot "50xCreative"

on PlayerHideEvent:
	joinQuitMessage(event.getPlayer(), "quit")

on PlayerShowEvent:
	joinQuitMessage(event.getPlayer(), "join")

on quit:
	set quit message to ""
	player doesn't have metadata "vanished"
	joinQuitMessage(player, "quit")

on join:
	set join message to ""
	send nl repeated 500 time to player
	set {_h::*} to "" #playerHead(player)
	set {_l::1} to "&8&m                                                                              "
	set {_l::2} to "%{_h::1} ? ""% &8&l┋ &fWelcome to {@name}"
	set {_l::3} to "%{_h::2} ? ""% &8&l┋ &b★ <#DEDEDE>ᴘʀᴇᴍɪᴜᴍ ᴄʀᴇᴀᴛɪᴠᴇ ᴇxᴘᴇʀɪᴇɴᴄᴇ &b★"
	set {_l::4} to "%{_h::3} ? ""% &8&l┋ "
	set {_l::5} to "%{_h::4} ? ""% &8&l┋ <#7777FF>■ &7Get updates & giveaways in our <ttp:&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴊᴏɪɴ ᴏᴜʀ ᴅɪsᴄᴏʀᴅ sᴇʀᴠᴇʀ><url:https://discord.gg/2e9xuYGFUx/><#7777FF>&ndiscord&r"
	set {_l::6} to "%{_h::5} ? ""% &8&l┋ <#FF99FF>■ &7Support us by shopping at our <ttp:&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴠɪsɪᴛ ᴏᴜʀ sᴛᴏʀᴇ><url:https://50xCreative.tebex.io/><#FF99FF>&nstore&r"
	set {_l::7} to "%{_h::6} ? ""% &8&l┋ <#FF6767>■ &7Remember to follow all of the <ttp:&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ʀᴇᴀᴅ ᴛʜᴇ sᴇʀᴠᴇʀ ʀᴜʟᴇs><cmd:/rules><#FF6767>&nrules&r"
	set {_l::8} to "%{_h::7} ? ""% &8&l┋ "
	set {_l::9} to "%{_h::8} ? ""% &8&l┋ <ttp:&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴄᴏᴘʏ ᴏᴜʀ sᴇʀᴠᴇʀ ɪᴘ><sgt:50xCreative.fun><#16E3FF>50xCreative.fun"
	set {_l::10} to "&8&m                                                                              "
	send formatted {_l::*} to player
	player has played before:
		player doesn't have metadata "vanished"
		joinQuitMessage(player, "join")
	else:
		joinQuitMessage(player, "new")
		set player's metadata "wlc" to true
		wait 10 second
		clear player's metadata "wlc"
	spawn(player, "lobby")

