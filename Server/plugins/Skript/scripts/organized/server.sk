every 20 seconds:
	delete bossbar named "x"
	set {_bar} to bossbar named "x" with title "&d&lSTORE &7» <#FF99FF>discord.gg/2e9xuYGFUx" with color pink with style solid bar with progress 100
	add all players to {_bar}
	loop 100 times:
		set bossbar progress of {_bar} to 100 - loop-value
		wait 1 tick
	delete bossbar named "x"
	set {_bar} to bossbar named "x" with title "&9&lDISCORD &7» <#7777FF>discord.gg/2e9xuYGFUx" with color purple with style solid bar with progress 100
	add all players to {_bar}
	loop 100 times:
		set bossbar progress of {_bar} to 100 - loop-value
		wait 1 tick
	delete bossbar named "x"
	set {_bar} to bossbar named "x" with title "&a&lWEBSITE &7» <#99FF99>www.50xCreative.fun" with color light green with style solid bar with progress 100
	add all players to {_bar}
	loop 100 times:
		set bossbar progress of {_bar} to 100 - loop-value
		wait 1 tick
	delete bossbar named "x"
	set {_bar} to bossbar named "x" with title "&6&lSERVER IP &7» &e50xCreative.fun" with color gold with style solid bar with progress 100
	add all players to {_bar}
	loop 100 times:
		set bossbar progress of {_bar} to 100 - loop-value
		wait 1 tick

