on skript load:
	while true = true:
		wait 1 minute
		# 5$ EVERY 30 MINUTES
		loop all players:
			add 5 to {cash::%loop-player's uuid%}
			send "{@info} You have earned &a5$ &ffor playing the game!" to loop-player
			play sound "block.note_block.pling" at pitch 1.5 for loop-player

		# AUTOBROADCAST AND CHAT GAMES
		wait 4 minute
		loop all players where [{s::bcast::%input's uuid%} isn't set]:
			play sound "block.note_block.pling" at pitch 1.2 for loop-player
			send "%minimessage from "<gradient:#AE0000:#FF2929:#AE0000><st>•                                                 •"%" to loop-player
			send "" to loop-player
			send " <#AE0000>&lWITNESS RULE BREAKERS?" to loop-player
			send " <#E0E0E0>Report them as soon as possible and" to loop-player
			send " <#E0E0E0>our staffs will take care of them." to loop-player
			send "" to loop-player
			send " <#AE0000>→ &fᴄʟɪᴄᴋ <ttp:&aᴄʟɪᴄᴋ ᴍᴇ><cmd:/report>&a&nʜᴇʀᴇ&r ᴛᴏ ʀᴇᴘᴏʀᴛ <#AE0000>←" to loop-player
			send "" to loop-player
			send "%minimessage from "<gradient:#AE0000:#FF2929:#AE0000><st>•                                                 •"%" to loop-player

		wait 2.5 minute
		chatGames(1) if {cgames::now} isn't set
		wait 2.5 minute
		loop all players where [{s::bcast::%input's uuid%} isn't set]:
			play sound "block.note_block.pling" at pitch 1.2 for loop-player
			send "%minimessage from "<gradient:#FF9100:#FFB939:#FF9100><st>•                                                 •"%" to loop-player
			send "" to loop-player
			send " <#FF9100>&lFOLLOW ALL RULES" to loop-player
			send " <#E0E0E0>Keep our server safe and fun by" to loop-player
			send " <#E0E0E0>following all rules at all times." to loop-player
			send "" to loop-player
			send " <#FF9100>→ &fᴄʟɪᴄᴋ <ttp:&aᴄʟɪᴄᴋ ᴍᴇ><cmd:/rules>&a&nʜᴇʀᴇ&r ᴛᴏ ʀᴇᴀᴅ <#FF9100>←" to loop-player
			send "" to loop-player
			send "%minimessage from "<gradient:#FF9100:#FFB939:#FF9100><st>•                                                 •"%" to loop-player

		wait 5 minute
		loop all players where [{s::bcast::%input's uuid%} isn't set]:
			play sound "block.note_block.pling" at pitch 1.2 for loop-player		
			send "%minimessage from "<gradient:#00FF11:#39FF46:#00FF11><st>•                                                 •"%" to loop-player
			send "" to loop-player
			send " <#00FF11>&lVOTE FOR OUR SERVER" to loop-player
			send " <#E0E0E0>Vote for us to gain rewards" to loop-player
			send " <#E0E0E0>and help us to grow bigger!" to loop-player
			send "" to loop-player
			send " <#00FF11>→ &fᴄʟɪᴄᴋ <ttp:&aᴄʟɪᴄᴋ ᴍᴇ><cmd:/vote>&a&nʜᴇʀᴇ&r ᴛᴏ ᴠᴏᴛᴇ <#00FF11>←" to loop-player
			send "" to loop-player
			send "%minimessage from "<gradient:#00FF11:#39FF46:#00FF11><st>•                                                 •"%" to loop-player

		wait 2.5 minute
		chatGames(2) if {cgames::now} isn't set
		wait 2.5 minute
		loop all players where [{s::bcast::%input's uuid%} isn't set]:
			play sound "block.note_block.pling" at pitch 1.2 for loop-player	
			send "%minimessage from "<gradient:#7129FF:#BE93FF:#7129FF><st>•                                                 •"%" to loop-player
			send "" to loop-player
			send " <#9651FF>&lWE HAVE DISCORD" to loop-player
			send " <#E0E0E0>Come and chat with other members," to loop-player
			send " <#E0E0E0>join in events and giveaways too!" to loop-player
			send "" to loop-player
			send " <#9651FF>→ &fᴄʟɪᴄᴋ <ttp:&aᴄʟɪᴄᴋ ᴍᴇ><url:https://discord.gg/2e9xuYGFUx/>&a&nʜᴇʀᴇ&r ᴛᴏ ᴊᴏɪɴ <#9651FF>←" to loop-player
			send "" to loop-player
			send "%minimessage from "<gradient:#7129FF:#BE93FF:#7129FF><st>•                                                 •"%" to loop-player

###
			play sound "block.note_block.pling" at pitch 1.2 for loop-player	
			send "%minimessage from "<gradient:#0079FF:#6CC9FF:#0079FF><st>•                                                 •"%" to loop-player
			send "" to loop-player
			send " <#0079FF>&lAPPLY FOR STAFF" to loop-player
			send " <#E0E0E0>Come and apply to be a staff here" to loop-player
			send " <#E0E0E0>and help us to moderate the server!" to loop-player
			send "" to loop-player
			send " <#0079FF>→ &fᴄʟɪᴄᴋ <ttp:&aᴄʟɪᴄᴋ ᴍᴇ><url:https://discord.gg/2e9xuYGFUx/>&a&nʜᴇʀᴇ&r ᴛᴏ ᴀᴘᴘʟʏ <#0079FF>←" to loop-player
			send "" to loop-player
			send "%minimessage from "<gradient:#0079FF:#6CC9FF:#0079FF><st>•                                                 •"%" to loop-player
###
		wait 5 minute
		loop all players where [{s::bcast::%input's uuid%} isn't set]:
			play sound "block.note_block.pling" at pitch 1.2 for loop-player	
			send "%minimessage from "<gradient:#7129FF:#BE93FF:#7129FF><st>•                                                 •"%" to loop-player
			send "" to loop-player
			send " <#9651FF>&lWE HAVE DISCORD" to loop-player
			send " <#E0E0E0>Come and chat with other members," to loop-player
			send " <#E0E0E0>join in events and giveaways too!" to loop-player
			send "" to loop-player
			send " <#9651FF>→ &fᴄʟɪᴄᴋ <ttp:&aᴄʟɪᴄᴋ ᴍᴇ><url:https://discord.gg/2e9xuYGFUx/>&a&nʜᴇʀᴇ&r ᴛᴏ ᴊᴏɪɴ <#9651FF>←" to loop-player
			send "" to loop-player
			send "%minimessage from "<gradient:#7129FF:#BE93FF:#7129FF><st>•                                                 •"%" to loop-player

		wait 2.5 minute
		chatGames(3) if {cgames::now} isn't set
		wait 2.5 minute
		loop all players where [{s::bcast::%input's uuid%} isn't set]:
			play sound "block.note_block.pling" at pitch 1.2 for loop-player		
			send "%minimessage from "<gradient:#FF00F8:#FF6CF5:#FF00F8><st>•                                                 •"%" to loop-player
			send "" to loop-player
			send " <#FF00F8>&lVISIT OUR WEBSTORE" to loop-player
			send " <#E0E0E0>Check out our online webstore" to loop-player
			send " <#E0E0E0>for ranks at reasonable prices!" to loop-player
			send "" to loop-player
			send " <#FF00F8>→ &fᴄʟɪᴄᴋ <ttp:&aᴄʟɪᴄᴋ ᴍᴇ><url:https://discord.gg/2e9xuYGFUx/>&a&nʜᴇʀᴇ&r ᴛᴏ ᴠɪsɪᴛ <#FF00F8>←" to loop-player
			send "" to loop-player
			send "%minimessage from "<gradient:#FF00F8:#FF6CF5:#FF00F8><st>•                                                 •"%" to loop-player

# ================================================================================================================================================================= #

