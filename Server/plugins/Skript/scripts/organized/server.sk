# =============== #
# BOUGHTFROMSTORE #
# =============== #

command boughtfromstore69 <text> <text>:
	permission: op
	trigger:
		if arg-2 is "Architect":
			set {_x} to "<#00FFC7>&ki&8[<#00FFC7>ᴀʀᴄʜɪᴛᴇᴄᴛ&8]<#00FFC7>&ki"
		if arg-2 is "Engineer":
			set {_x} to "<#FFD64E>&ki&8[<#FFD64E>ᴇɴɢɪɴᴇᴇʀ&8]<#FFD64E>&ki"
		if arg-2 is "Creator":
			set {_x} to "<#FF8F4E>&ki&8[<#FF8F4E>ᴄʀᴇᴀᴛᴏʀ&8]<#FF8F4E>&ki"
		if arg-2 is "Designer":
			set {_x} to "<#00EAFF>&ki&8[<#00EAFF>ᴅᴇsɪɢɴᴇʀ&8]<#00EAFF>&ki"
		broadcast "%nl%&8-----------------------------------------------------"
		broadcast "                           <#08FB5D>5<#12FB67>0<#1DFA71>x<#27FA7B>C<#31F985>r<#3CF98F>e<#46F899>a<#50F8A3>t<#5BF7AD>i<#65F7B7>v<#6FF6C1>e<#79F6CB> <#84F5D5>S<#8EF5DF>t<#98F4E9>o<#A3F4F3>r<#ADF3FD>e                 "
		broadcast "               &b&l%ARG-1% &r&ajust bought %{_x}%&r&a rank!      "
		broadcast "                                    <#08FB5D>/<#31F985>b<#5BF7AD>u<#84F5D5>y<#ADF3FD>!"
		loop all players:
			play sound "ui.toast.challenge_complete" with pitch 1.5 to loop-player
		broadcast "&8-----------------------------------------------------%nl%"
