slash command appeal <string="action"> <user="member"> <string="punishment"> <string="target"> <string="reason"> [<string="strike">]:
	description: Allows appeal or denies one.
	arguments:
		action:
			description: Accept or deny appeal.
			on completion request:
				add new choice "Accept" with value "Accept" to {_a::*}
				add new choice "Deny" with value "Deny" to {_a::*}
				return {_a::*}
		punishment:
			description: Punishment type.
			on completion request:
				add new choice "Mute" with value "Mute" to {_b::*}
				add new choice "Ban" with value "Ban" to {_b::*}
				add new choice "Warn" with value "Warn" to {_b::*}
				return {_b::*}
		target:
			description: Minecraft username of the user.
			on completion request:
				loop all players:
					add new choice "%loop-player%" with value "%loop-player%" to {_c::*}
				return {_c::*}
		member: Person to be decided of their fate.
		reason: Reason for the player to be appealed/unapplied.
		strike:
			description: Remove griefing offense.
			on completion request:
				add new choice "True" with value "True" to {_b::*}
				add new choice "False" with value "False" to {_b::*}
				return {_b::*}
	bot: 50xCreative
	guilds: 1129335265907978260
	trigger:
		event-member has discord role with id "1130063796090712146":
			if arg-1 is "accept":
				if arg-3 is "Mute":
					console command "unmute %arg-4% Unmuted by %discord name of event-member%: %arg-5%"
				if arg-3 is "Ban":
					console command "unban %arg-4% Unbanned by %discord name of event-member%: %arg-5%"
				if arg-3 is "Warn":
					console command "unwarn %arg-4% Unwarned by %discord name of event-member%: %arg-5%"
				if arg-6 is "True":
					console command "removestrikes %arg-4%"
				open private channel of arg-2 and store it in {_ch}
				create a new message and store it in {_msgass}:
					set the content of the message to "Valuator: %event-user%"
					make embed:
						set title of embed to "Your Appeal for %arg-3% has been accepted."
						set embed color of embed to lime
						set footer of embed to "Notes: %arg-5%"
					add last embed to the embeds of the message
				post {_msgass} to {_ch} if {_ch} is set
				reply with ":white_check_mark: Successfully accepted appeal - punishment `%arg-3%` for `%arg-4%` for the reason: `%arg-5%`"
				stop
			else:
				open private channel of arg-2 and store it in {_ch}
				create a new message and store it in {_msgass}:
					set the content of the message to "Valuator: %event-user%"
					make embed:
						set title of embed to "Your Appeal for %arg-3% has been denied."
						set embed color of embed to red
						set footer of embed to "Reason: %arg-5%"
					add last embed to the embeds of the message
				post {_msgass} to {_ch} if {_ch} is set
				reply with ":white_check_mark: Successfully denied appeal - punishment `%arg-3%` for `%arg-4%` for the reason: `%arg-5%`"
		else:
			reply with hidden "You are not authorised for this command."

function DCChatLog(p: offline player, m: text):
	replace all "@" with "" in {_m}
	replace all "_" with "\_" in {_m}
	replace all "*" with "\*" in {_m}
	replace all "`" with "\`" in {_m}
	make new embed and store it in {_embed}:
		set author of embed to {_p}'s name
		set author icon of embed to "https://mc-heads.net/avatar/%{_p}%"
		set description of embed to unformatted {_m}
		set embed color of embed to hex "#770000" if {_p}'s group = "owner"
		set embed color of embed to hex "#880000" if {_p}'s group = "co-owner"
		set embed color of embed to hex "#D143FF" if {_p}'s group = "developer"
		set embed color of embed to hex "#FF0080" if {_p}'s group = "manager"
		set embed color of embed to hex "#CA0000" if {_p}'s group = "sradmin"
		set embed color of embed to hex "#FF0000" if {_p}'s group = "admin"
		set embed color of embed to hex "#FF5D00" if {_p}'s group = "srmod"
		set embed color of embed to hex "#FFA500" if {_p}'s group = "mod"
		set embed color of embed to hex "#FFE300" if {_p}'s group = "jrmod"
		set embed color of embed to hex "#00D339" if {_p}'s group = "trainee"
		set embed color of embed to hex "#FF6AD1" if {_p}'s group = "media"
		set embed color of embed to hex "#FF8F4E" if {_p}'s group = "creator"
		set embed color of embed to hex "#FFD64E" if {_p}'s group = "engineer"
		set embed color of embed to hex "#00FFC7" if {_p}'s group = "architect"
		set embed color of embed to hex "#00EAFF" if {_p}'s group = "designer"
		set embed color of embed to hex "#9CA9B3" if {_p}'s group = "default"
	post {_embed} to text channel with id "1417472418217197679" with bot bot "50xCreative"

	
on command:
	sender is a player
	sender isn't an operator
	post "`%sender%` has executed `/%full command%`" to text channel with id "1423179383698358403" with bot bot "50xCreative"

message command quote:
    bot: my_bot
    trigger:
        set {_e} to new embed:
            author: discord name of author of target message
            author icon: avatar url of author of target message
            description: content of target message
            color: blue
            footer: "Quoted by %event-user%"
        reply with {_e}