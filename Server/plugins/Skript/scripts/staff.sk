#==========================================================================#

options:
	err: &8(&4&l❗&8)&c
	info: &8(<##FC00FF>&l❗&8)&f

	usage: &8(&4&l❗&8) &cCorrect command usage &7»&f
	notyou: &8(&4&l❗&8) &cConsole may not use this command.
	noperm: &8(&4&l❗&8) &cYou do not have permission for this command.
	notthis: &8(&4&l❗&8) &cYou may not use this feature of the command.
	nothere: &8(&4&l❗&8) &cYou may not use this command in this region.
	nothigh: &8(&4&l❗&8) &cThat person has a higher authority than you.
	notnow: &8(&4&l❗&8) &cYou may use this command after %remaining time%.

#==========================================================================#

# ========= #
# BROADCAST #
# ========= #
 
command broadcast <text>:
	prefix: staff
	aliases: bc, announce
	usage: {@usage} /broadcast &f<text>
	permission: staff.broadcast
	permission message: {@noperm}
	trigger:
		play sound "block.note_block.pling" at pitch 2 for all players
		broadcast "%nl%%minimessage from "<gradient:#fb7100:#f0fd00><b>[❗] ANNOUNCEMENT [❗]"%%nl%%formatted arg-1%%nl%"

# ========= #
# CLEARCHAT #
# ========= #

on load:
	{-ChatClear::*} isn't set
	loop 2000 times:
		add random integer between 0 and 69420 to {-ChatClear::*}

on tab complete of "cc", "clearchat" and "chatclear":
	sender has permission "staff.clearchat"
	set tab completions for position 1 to all players

command clearchat [<player>]:
	prefix: staff
	aliases: cc, chatclear
	usage: {@usage} /<cc | clearchat | chatclear> &7[player]
	permission: staff.clearchat
	permission message: {@noperm}
	trigger:
		arg-1 is set:
			priority(sender) < priority(arg-1):
				send "{@nothigh}"
			else:
				send nl repeated 1000 times to arg-1
				send "%nl%{@info} Your chat has been &acleared &fby &e%"you" if arg-1 = sender else sender%&f.%nl%" to arg-1
				stafflog("%sender% &fhas cleared <#B247FF>%arg-1 if sender != arg-1 else "&ftheir own"% chat.") if arg-1 != sender
		else:
			set {_p::*} to all players where [priority(input) < 10]
			send {-ChatClear::*} to {_p::*}
			send nl repeated 200 times to {_p::*}
			broadcast "%nl%%minimessage from "<b><gradient:#FF6700:#FFFB6A>50xCreative"% &8→ &6%sender% &fhas &acleared &fthe &eserver's chat&f.%nl%"

# ==== #
# FAKE #
# ==== #

command fakewarn <text> <text> <text>:
	prefix: staff
	usage: {@usage} /fakewarn <executor> <victim> <reason>
	permission: staff.fake.warn
	permission message: {@noperm}
	trigger:
		set {_random} to random integer between 1000 and 9999
		broadcast ""
		broadcast " <#A7D9FF>&lᴡᴀʀɴ ᴀʟᴇʀᴛ"
		broadcast " "
		broadcast " <#b6d9d8>ℹ <#A7D9FF>&lɪᴅ <#b6d9d8>%{_random}%"
		broadcast "    <#ff5348>☄ <#A7D9FF>ᴏꜰꜰᴇɴᴅᴇʀ <#ff5348>%arg-2%  "
		broadcast "    <#a9c8ff>🪓 <#A7D9FF>ᴘᴜɴɪꜱʜᴇʀ <#a9c8ff>%arg-1%"
		broadcast "    <#c19a6b>✎ <#A7D9FF>ʀᴇᴀꜱᴏɴ <#c19a6b>%arg-3%"
		broadcast " "
		stafflog("<#C26EFF>The warn made by &e%sender% <#C26EFF>was fake &f:)")

