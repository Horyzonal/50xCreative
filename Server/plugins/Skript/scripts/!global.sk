			send "%nl%%minimessage from "<bold><gradient:#FF6700:#FFFB6A>50xCreative"% &8&l┊ &6&lRules%nl%"
			send "%minimessage from "<gradient:#FF0000:#FF8600>NO ENTITY SPAM</gradient>"%%nl%&fDo not spawn excessive amounts of entities that cause lag, disrupt builds, or annoy other players. Abuse of entity spamming will result in potential bans.%nl%"
			send formatted "<ttp:&aClick &fto go to the previous page!><run command:/rules 11>&7<< Previous Page<reset> &8| <ttp:&aClick &fto go to the next page!><run command:/rules 13>&7Next page »<reset>%nl%"
		else if arg-1 = 13:
			send "%nl%%minimessage from "<bold><gradient:#FF6700:#FFFB6A>50xCreative"% &8&l┊ &6&lRules%nl%"
			send "%minimessage from "<gradient:#FF0000:#FF8600>NO FORMS OF ANNOYANCE</gradient>"%%nl%&fThis includes chat flooding, sound spam, obstructing other players' movement, and similar disruptive behavior.%nl%"
			send formatted "<ttp:&aClick &fto go to the previous page!><run command:/rules 12>&7<< Previous Page<reset> &8| <ttp:&aClick &fto go to the next page!><run command:/rules 14>&7Next page »<reset>%nl%"
		else if arg-1 = 14:
			send "%nl%%minimessage from "<bold><gradient:#FF6700:#FFFB6A>50xCreative"% &8&l┊ &6&lRules%nl%"
			send "%minimessage from "<gradient:#FF0000:#FF8600>NO LAND CLAIMS</gradient>"%%nl%&fClaiming land in the creative world is strictly forbidden. Build considerately and respect shared space.%nl%"
			send formatted "<ttp:&aClick &fto go to the previous page!><run command:/rules 13>&7<< Previous Page<reset> &8| <ttp:&aClick &fto go to the next page!><run command:/rules 15>&7Next page »<reset>%nl%"
		else if arg-1 = 15:
			send "%nl%%minimessage from "<bold><gradient:#FF6700:#FFFB6A>50xCreative"% &8&l┊ &6&lRules%nl%"
