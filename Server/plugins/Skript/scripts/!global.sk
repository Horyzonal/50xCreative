			send formatted "<ttp:&aClick &fto go to the previous page!><run command:/rules 14>&7<< Previous Page<reset> &8| <ttp:&aClick &fto go to the next page!><run command:/rules 16>&7Next page »<reset>%nl%"
		else if arg-1 = 16:
			send "%nl%%minimessage from "<bold><gradient:#FF6700:#FFFB6A>50xCreative"% &8&l┊ &6&lRules%nl%"
			send "%minimessage from "<gradient:#FF0000:#FF8600>NO DISRESPECTFUL BEHAVIOUR OR CONTENT</gradient>"%%nl%&fThis includes calling players disrespectful names, mocking builds, or building over another player's work out of spite or disagreement.%nl%"
			send formatted "<ttp:&aClick &fto go to the previous page!><run command:/rules 15>&7<< Previous Page<reset> &8| <ttp:&aClick &fto go to the next page!><run command:/rules 17>&7Next page »<reset>%nl%"
		else if arg-1 = 17:
			send "%nl%%minimessage from "<bold><gradient:#FF6700:#FFFB6A>50xCreative"% &8&l┊ &6&lRules%nl%"
