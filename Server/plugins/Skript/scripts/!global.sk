			send "%minimessage from "<gradient:#FF0000:#FF8600>NO REPEATED STANDALONE FLAG BUILDS</gradient>"%%nl%&fFlags such as LGBTQ+ flags or similar are prohibited from being built more than 3 times.%nl%"
			send formatted "<ttp:&aClick &fto go to the previous page!><run command:/rules 6>&7<< Previous Page<reset> &8| <ttp:&aClick &fto go to the next page!><run command:/rules 8>&7Next page »<reset>%nl%"
		else if arg-1 = 8:
