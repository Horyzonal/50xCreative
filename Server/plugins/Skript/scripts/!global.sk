		else:
			send usage


# ====================================================================================================== #

# SPAWN

options:
	cosmetics: chest named "<#16E3FF>Cosmetics &8• &7ʀɪɢʜᴛ-ᴄʟɪᴄᴋ" with lore "&8ᴍᴇɴᴜ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Tweak your cosmetic configuration and", " <#78EFFF>| &7custom particle effects to your liking." with custom nbt from "{""type"":""cosmetics""}"
	gamemenu: recovery compass named "<#16E3FF>Selector &8• &7ʀɪɢʜᴛ-ᴄʟɪᴄᴋ" with lore "&8ᴍᴇɴᴜ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Use this magical compass to travel" and " <#78EFFF>| &7across all available gamemodes."  with custom nbt from "{""type"":""game""}"
	options: comparator named "<#16E3FF>Options &8• &7ʀɪɢʜᴛ-ᴄʟɪᴄᴋ" with lore "&8ᴍᴇɴᴜ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Tweak some settings of the server", " <#78EFFF>| &7tailored to your needs."  with custom nbt from "{""type"":""options""}"

on leftclick:
	event-world = "lobby":
		event-item = {@cosmetics}:
			cancel event
			cosmetics(player)
		event-item = {@gamemenu}:
			cancel event
			gamemenu(player)
		event-item = {@options}:
			cancel event
			options(player)

on rightclick:
	event-world = "lobby":
		event-item = {@cosmetics}:
			cancel event
			cosmetics(player)
		event-item = {@gamemenu}:
			cancel event
			gamemenu(player)
		event-item = {@options}:
			cancel event
			options(player)

		"%event-entity%" = "!randomizer":
			cancel event
			spawn(player, "50xrngrush")
		"%event-entity%" = "!creative":
			cancel event
			spawn(player, "creative")
		"%event-entity%" = "!plots":
			cancel event
			spawn(player, "plots")
		"%event-entity%" = "!tag":
			cancel event
			spawn(player, "tag")

function wchange(p: player, t: text):
	{_t} = {@supported_worlds} or "chaos":
		priority({_p}) <= 12
		set {_p}'s gamemode to creative
	else if {_t} = "lobby":
		clear {_p}'s inventory
		set {_p}'s level to 1
		set hotbar slot of {_p} to slot 4 of {_p}
		set slot 2 of {_p}'s inventory to {@cosmetics}
		set slot 4 of {_p}'s inventory to {@gamemenu}
		set slot 6 of {_p}'s inventory to {@options}
		set {_p}'s flight mode to true
		priority({_p}) <= 12
		set {_p}'s gamemode to adventure
	else:
		priority({_p}) <= 12
		set {_p}'s gamemode to adventure

on player world change:
	player's gamemode != spectator
	wait 2 tick
	wchange(event-player, name of event-player's world)

function spawn(p: player, w: text = "lobby"):
	{lock::%{_w}%} is set:
		play sound "block.anvil.land" at pitch 0.7 for {_p}
		send "{@warn} This game is currently locked. Contact an administrator if you think this is an issue. We apologize for any inconvenience caused." to {_p}
	else if {spawn::%{_w}%} isn't set:
		play sound "block.anvil.land" at pitch 0.7 for {_p}
		send "{@warn} The spawn of this game is currently unset. Contact an administrator about this issue. We apologize for any inconvenience caused." to {_p}
	else:
		clear passengers of {_p}
		make {_p} dismount if {_p} is riding
		teleport {_p} to {spawn::%{_w}%}
		wait 1 tick
		wchange({_p}, {_w})
		play sound "entity.player.levelup" at pitch 0.7 for {_p}
		send title "%logo({_w})% &l%{_w} in uppercase%&r %logo({_w})%" with subtitle "&fYou have been teleported." to {_p} for 1.5 seconds with fadein 0.3 second and fade out 0.3 second
		send "{@info} ᴄᴏɴɴᴇᴄᴛᴇᴅ ʏᴏᴜ ᴛᴏ <#16E3FF>&l%smallcaps({_w})%&f." to {_p}
		send "{@info} &fғʟɪɢʜᴛ ᴍᴏᴅᴇ ʜᴀs ʙᴇᴇɴ &aᴇɴᴀʙʟᴇᴅ&f." to {_p}
		set block below {_p} to white stained glass if block below {_p} = air or light

function gamemenu(p: player):
	create gui with virtual chest inventory with 6 row named "        &n♦ ɢᴀᴍᴇ sᴇʟᴇᴄᴛᴏʀ ♦":
		make gui slot (integers from 0 to 9, 17, 18, 26, 27, 35, 36, 44, integers from 45 to 53) with black stained glass pane without tooltip
		make gui slot 11 with {head::plots} named "&6&lPLOTS" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Display your artistic creations in a", " <#78EFFF>| &7200x200 plot world that never resets.", "", " &8⋅ <#E0E0E0>sᴛᴀᴛᴜs: <#76FF90>ᴏɴʟɪɴᴇ", " &8⋅ <#E0E0E0>ᴠᴇʀsɪᴏɴ: <#76FF90>1.20+", "" and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴘʟᴀʏ ᴡɪᴛʜ &a%realPlayers("plots")% &fᴘʟᴀʏᴇʀs":
			close {_p}'s inventory
			spawn({_p}, "plots")	
		make gui slot 13 with {head::creative} named "&a&lCREATIVE" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Come and unleash your creativity", " <#78EFFF>| &7in this 125x125 creative world.", "", " &8⋅ <#E0E0E0>sᴛᴀᴛᴜs: <#76FF90>ᴏɴʟɪɴᴇ", " &8⋅ <#E0E0E0>ᴠᴇʀsɪᴏɴ: <#76FF90>1.20+", " &8⋅ <#E0E0E0>ʀᴇsᴇᴛs: <#76FF90>True", "" and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴘʟᴀʏ ᴡɪᴛʜ &a%realPlayers("creative")% &fᴘʟᴀʏᴇʀs":
			close {_p}'s inventory
			spawn({_p}, "creative")
		make gui slot 15 with {head::chaos} named "&c&lCHAOS" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Let your intrusive thoughts", " <#78EFFF>| &7have some menacing fun.", "", " &8⋅ <#E0E0E0>sᴛᴀᴛᴜs: <#76FF90>ᴏɴʟɪɴᴇ", " &8⋅ <#E0E0E0>ᴠᴇʀsɪᴏɴ: <#76FF90>1.20+", " &8⋅ <#E0E0E0>ʀᴇsᴇᴛs: <#76FF90>True", "" and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴘʟᴀʏ ᴡɪᴛʜ &a%realPlayers("chaos")% &fᴘʟᴀʏᴇʀs":
			close {_p}'s inventory
			spawn({_p}, "chaos")
		{_p} has permission "donator.chat":
			make gui slot 20 with {head::donor} named "&b&lDONATOR" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Special creative world only", " <#78EFFF>| &7for donators and above.", "", " &8⋅ <#E0E0E0>sᴛᴀᴛᴜs: <#76FF90>ᴏɴʟɪɴᴇ", " &8⋅ <#E0E0E0>ᴠᴇʀsɪᴏɴ: <#76FF90>1.20+", "" and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴘʟᴀʏ ᴡɪᴛʜ &a%realPlayers("donator")% &fᴘʟᴀʏᴇʀs":
				close {_p}'s inventory
				spawn({_p}, "donor")
		{_p} has permission "staff.chat":
			make gui slot 22 with {head::staff} named "&c&lSTAFF" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Special creative world only", " <#78EFFF>| &7for staffs and above.", "", " &8⋅ <#E0E0E0>sᴛᴀᴛᴜs: <#76FF90>ᴏɴʟɪɴᴇ", " &8⋅ <#E0E0E0>ᴠᴇʀsɪᴏɴ: <#76FF90>1.20+", "" and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴘʟᴀʏ ᴡɪᴛʜ &a%realPlayers("donator")% &fᴘʟᴀʏᴇʀs":
				close {_p}'s inventory
				spawn({_p}, "staff")
		{_p} has permission "admin.chat":
			make gui slot 24 with {head::admin} named "&d&lADMIN" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Special creative world only", " <#78EFFF>| &7for admins and above.", "", " &8⋅ <#E0E0E0>sᴛᴀᴛᴜs: <#76FF90>ᴏɴʟɪɴᴇ", " &8⋅ <#E0E0E0>ᴠᴇʀsɪᴏɴ: <#76FF90>1.20+", "" and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴘʟᴀʏ ᴡɪᴛʜ &a%realPlayers("donator")% &fᴘʟᴀʏᴇʀs":
				close {_p}'s inventory
				spawn({_p}, "admin")
		make gui slot 29 with {head::event} named "&6&lEVENT" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "" and "&cCOMING SOON":
			close {_p}'s inventory
		make gui slot 31 with {head::tag} named "&f&lTAG" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "", "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Chase or escape in this", " <#78EFFF>| &7fast-paced game of tag!", "", " &8⋅ <#E0E0E0>sᴛᴀᴛᴜs: <#76FF90>ᴏɴʟɪɴᴇ", " &8⋅ <#E0E0E0>ᴠᴇʀsɪᴏɴ: <#76FF90>1.20+", " &8⋅ <#E0E0E0>ᴘʟᴀʏᴇʀs ɴᴇᴇᴅᴇᴅ: <#76FF90>2+", "" and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴘʟᴀʏ ᴡɪᴛʜ &a%realPlayers("tag")% &fᴘʟᴀʏᴇʀs":
			close {_p}'s inventory
			spawn({_p}, "tag")
		make gui slot 33 with {head::unknown} named "&7&lUNKNOWN" with lore "&8ɢᴀᴍᴇᴍᴏᴅᴇ", "" and "&cCOMING SOON":
			close {_p}'s inventory
		make gui slot 40 with {head::spawn} named "&9&lSPAWN" with lore "&8ʟᴏʙʙʏ", "" and "<#78EFFF>ⓘ ɪɴꜰᴏʀᴍᴀᴛɪᴏɴ", " <#78EFFF>| &7Go back to the original", " <#78EFFF>| &7server spawn location!", "", and "&2&l￫ &aᴄʟɪᴄᴋ &fᴛᴏ ᴄʜɪʟʟ ᴡɪᴛʜ &a%realPlayers("lobby")% &fᴘʟᴀʏᴇʀs":
			close {_p}'s inventory
			spawn({_p})
	open last gui for {_p}
	invsfx({_p})
	
command menu:
	prefix: core
	trigger:
		gamemenu(player)

on tab complete of "spawn", "hub" or "lobby":
	sender has permission "core.spawn.others"
	set tab completions for position 1 to all players

command spawn <player=%player%> <text="lobby">:
	prefix: core
	aliases: hub, lobby
	usage: {@usage} /spawn &7[player] [world]
	trigger:
		sender = console:
			arg-1 isn't set:
				send "{@usage} /spawn <player> &7[world]"
			else:
				spawn(arg-1, arg-2)
		else if arg-1 != player:
			if player doesn't have permission "staff.chat":
				send "{@notthis}"
			else if priority(arg-1) > priority(player):
				send "{@nothigh}"
			else:
				spawn(arg-1)
		else:
			spawn(player)

# ===== #
# STATS # 
# ===== #

on tab complete of "stats":
	set tab completions for position 1 to all players

command stats [<offlineplayer>]:
	prefix: core
	usage: {@usage} /stats &7[player]
	trigger:
		set {_p} to arg-1 ? player
		{_p} hasn't played before:
			send "{@warn} %{_p}% has not played before."
		else:
			send ""
			send "{@info} Statistics for &d%{_p}% %"&7(You)" if {_p} = player else ""%"
			send ""
			send " &6» &fRank &7- &d%toHex({_p}'s prefix)%"
			send " &6» &fJoined &7- &d%{_p}'s first login%"
			send " &6» &fPlaytime &7- &d%{_p}'s time played%"
			send " &6» &fBalance &7- &d$%numFormat({cash::%{_p}'s uuid%} ? 0)%"
			send ""

# === #
# TPA #
# === #

on load:
	delete {tp::*}

on tab complete of "tpa", "tpahere", "tpaccept" and "tpdeny":
	set tab completions for position 1 to all players

command tptoggle:
	prefix: core
	executable by: players
	trigger:
		if {s::tptoggle::%player's uuid%} is not set:
			set {s::tptoggle::%player's uuid%} to true
			send "{@warn} You will no longer be able to receive teleport requests."
		else:
			delete {s::tptoggle::%player's uuid%}
			send "{@info} &fYou will now be able to receive teleport requests."

command tpa <player>:
	prefix: core
	executable by: players
	usage: {@usage} /tpa &f<player>
	trigger:
		if {settings::tptoggle::%arg-1's uuid%} is not set:
			if {tp::%executor's uuid%::%arg-1's uuid%} is not set:
				send "{@info} &fYou have sent a teleport request to &e%arg-1%." to executor
				send "","{@info} &e%executor% &fwishes to teleport to you. &fUse &e/tpaccept %executor% &fto accept this teleport.","" to arg-1
				set {tp::%executor's uuid%::%arg-1's uuid%} to "t"
				wait 60 seconds
				delete {tp::%executor's uuid%::%arg-1's uuid%}
			else:
				send "{@warn} You have already sent a teleport request to this player." to executor
		else:
			send "{@warn} This player has teleport requests disabled."

command tpahere <player>:
	prefix: core
	executable by: players
	usage: {@usage} /tpahere &f<player>
	trigger:
		if {settings::tptoggle::%arg-1's uuid%} is not set:
			if {tp::%executor's uuid%::%arg-1's uuid%} is not set:
				send "{@info} &fYou have sent a teleport request to &e%arg-1%&f." to executor
				send "","{@info} &e%executor% &fwishes for you to teleport to them. &fUse &e/tpaccept %executor% &fto accept this teleport.","" to arg-1
				set {tp::%executor's uuid%::%arg-1's uuid%} to "h"
				wait 60 seconds
				delete {tp::%executor's uuid%::%arg-1's uuid%}
			else:
				send "{@warn} You have already sent a teleport request to this player." to executor
		else:
			send "{@warn} This player has teleport requests disabled."

command tpaccept <player>:
	prefix: core
	executable by: players
	usage: {@usage} /tpaccept &f<player>
	trigger:
		if {tp::%arg-1's uuid%::%executor's uuid%} is "t":
			delete {tp::%arg-1's uuid%::%executor's uuid%}
			send "{@info} &fYou have teleported to &e%executor%&f." to arg-1
			teleport arg-1 to executor
		else if {tp::%arg-1's uuid%::%executor's uuid%} is "h":
			delete {tp::%arg-1's uuid%::%executor's uuid%}
			send "{@info} &fYou have teleported to &e%executor%&f." to executor
			teleport executor to arg-1
				
command tpdeny <player>:
	prefix: core
	executable by: players
	usage: {@usage} /tpdeny &f<player>
	trigger:
		if {tp::%arg-1's uuid%::%executor's uuid%} is set:
			send "{@warn} You have denied &e%arg-1%'s &crequest to teleport." to executor
			send "{@info} &e%player% &chas denied your request to teleport." to arg-1
			delete {tp::%arg-1's uuid%::%executor's uuid%}
		else:
			send "{@warn} There is no pending teleport request from this player."

# ===== #
# VAULT #
# ===== #

function openVault(player:offlineplayer, id:integer, admin:player={_unset}):
	{_player} and {_id} are set
	close {_player}'s inventory
	invsfx({_player})
	set {_uuid} to uuid of {_player}
	set {_opener} to {_admin} ? {_player}
	set metadata "vault;owner" of {_opener} to {_uuid}
	set metadata "vault;id" of {_opener} to {_id}

	set {_inv} to chest inventory with 3 row named "%{_player}%'s Vault #%{_id}%"
	set metadata "vault;inventory" of {_opener} to {_inv}
	set {-vaultCache::%{_uuid}%::%{_id}%} to {_inv}
	loop indices of {vaults::%{_uuid}%::%{_id}%::*}:
		set slot (loop-value parsed as an integer) of {_inv} to {vaults::%{_uuid}%::%{_id}%::%loop-value%}

	open {_inv} to {_opener}
	
on inventory close:
	player has metadata "vault;inventory"
	invsfx(player)
	set {_vaultOwner} to metadata "vault;owner" of player
	set {_vaultId} to metadata "vault;id" of player
	clear metadata "vault;inventory","vault;owner","vault;id" of players
	clear {vaults::%{_vaultOwner}%::%{_vaultId}%::*}
	loop items in event-inventory:
		set {vaults::%{_vaultOwner}%::%{_vaultId}%::%index of loop-item%} to loop-item

on rightclick on ender chest:
	cancel event
	event-world = {@supported_worlds}
	VaultGui(player)

on tab complete for "v" and "vault":
	set tab completions for position 1 to indices of {vaults::%uuid of player%::*}

command vault [<id:int>] [<text>]:
	prefix: core
	usage: {@usage} /<v | vault> &7[1-7]
	aliases: v
	trigger:
		name of player's world = "50xSurvival":
			send "{@nothere}"
			stop
		arg-2 is set:
			send usage
		else if sender = console:
			send "{@notyou}"
		else if player's world != {@supported_worlds}:
			priority(player) < 7
			send "{@nothere}"
		else if arg-1 < 1:
			send "{@warn} All vaults start from 1."
		else if arg-1 > 7:
			send "{@warn} You can only have a maximum of 7 vaults."
		else if arg-1 is set:
			player doesn't have permission "vault.%arg-1%":
				send "{@warn} You do not have that much vaults."
			else if player's world != {@supported_worlds}:
				priority(player) < 7
				send "{@nothere}"
			else:
				openVault(player, {_id})
		VaultGui(player)
			
function VaultGui(p: offlineplayer):
	create a gui with virtual chest inventory with 1 row named "Vaults of %{_p}%":
		make gui slot (integers from 0 to 8) with black stained glass pane named ""
		{_p} has permission "vault.1":
			make gui slot 0 with chest named minimessage from "<gradient:#00FFFF:#00A2FF>Vault #1" with lore "&8ᴠᴀᴜʟᴛ" and "" and "&aClick &7to &fopen this vault&7!":
				openVault({_p}, 1)
		{_p} has permission "vault.2":
			make gui slot 1 with chest named minimessage from "<gradient:#00FFFF:#00A2FF>Vault #2" with lore "&8ᴠᴀᴜʟᴛ" and "" and "&aClick &7to &fopen this vault&7!":
				openVault({_p}, 2)
		{_p} has permission "vault.3":
			make gui slot 2 with chest named minimessage from "<gradient:#00FFFF:#00A2FF>Vault #3" with lore "&8ᴠᴀᴜʟᴛ" and "" and "&aClick &7to &fopen this vault&7!":
				openVault({_p}, 3)
		{_p} has permission "vault.4":
			make gui slot 3 with chest named minimessage from "<gradient:#00FFFF:#00A2FF>Vault #4" with lore "&8ᴠᴀᴜʟᴛ" and "" and "&aClick &7to &fopen this vault&7!":
				openVault({_p}, 4)
		{_p} has permission "vault.5":
			make gui slot 4 with chest named minimessage from "<gradient:#00FFFF:#00A2FF>Vault #5" with lore "&8ᴠᴀᴜʟᴛ" and "" and "&aClick &7to &fopen this vault&7!":
				openVault({_p}, 5)
		{_p} has permission "vault.6":
			make gui slot 5 with chest named minimessage from "<gradient:#00FFFF:#00A2FF>Vault #6" with lore "&8ᴠᴀᴜʟᴛ" and "" and "&aClick &7to &fopen this vault&7!":
				openVault({_p}, 6)
		{_p} has permission "vault.7":
			make gui slot 6 with chest named minimessage from "<gradient:#00FFFF:#00A2FF>Vault #7" with lore "&8ᴠᴀᴜʟᴛ" and "" and "&aClick &7to &fopen this vault&7!":
				openVault({_p}, 7)
		make gui slot 8 with barrier block named "&cClose" with lore "&8ᴀᴄᴛɪᴏɴ" and "" and "&aClick &7to &fclose the menu&7!":
			close {_p}'s inventory
			invsfx({_p})
	open the last gui for {_p}
	invsfx({_p})

# ============== #
# VOTE MAP RESET #
# ============== #

command testGui:
	permission: op
	trigger:
		voteGui(player)

function voteGui(p: offlineplayer):
	create a gui with virtual chest inventory with 1 row named "&AMap Reset Vote":
		make gui slot 3 with green_concrete named minimessage from "&a&lYes":
			make {_p} execute command "/vmr"
			close {_p}'s inventory
		make gui slot 5 with red_concrete named minimessage from "&c&lNo":
			close {_p}'s inventory
	open the last gui for {_p}

# ==== #
# YELL #
# ==== #

import:
    java.util.UUID
    litebans.api.Database

on load:
    create section with {_p} stored in {-isMuted}:
        set {_uuidString} to {_p}'s uuid
        if Database.get().isPlayerMuted({_uuidString}, name of {_p}) = true:
            return true
        return false

command yell <text>:
	prefix: core
	usage: {@usage} /<yell | shout> &f<message>
	aliases: shout
	cooldown: 10 rl minute
	cooldown message: {@notnow}
	cooldown bypass: staff.chat
	trigger:
		{mutechat} is set:
			stop

		sender's world is world "honey":
			send "&eBut nobody heard..." to sender
			stop
		run section {-isMuted} async with player and store result in {_hmm} and wait
		if {_hmm} is true:
			send "{@warn} You are currently muted."
			stop
		
		send "%nl%&6[YELL] &e%player%: &f%arg-1%%nl%" to all players where [input's world isn't world "honey"]
		cancel cooldown if priority(player) > 4
		wait 5 rl minute
		cancel cooldown if priority(player) > 3
		wait 3 rl minute
		cancel cooldown if priority(player) > 2

on inventory slot change:
	if event-item is tag "bundles":
		wait 3 ticks
		remove event-item from player's inventory
		remove event-item from player's inventory
		send "{@warn} Bundles are disabled."

on inventory slot change:
	if event-item is trident:
		wait 3 ticks
		remove event-item from player's inventory
		remove event-item from player's inventory
		send "{@warn} Tridents are disabled."

function msgPlayer(s: sender, p: player, m: string):
	if {_p}'s world is world "honey":
		{_s}'s world isn't world "honey"
		send "&eSignal rejected..." to {_s}
		stop
	if {_s}'s world is world "honey":
		{_p}'s world isn't world "honey"
		send "&eOutgoing signal got stuck in the honey..." to {_s}
		stop
	send "&8[&6MSG&8] &7To &b%{_p}% &8>> &f%{_m}%" to {_s}
	send "&8[&6MSG&8] &7From &b%{_s}%&8 >> &f%{_m}%" to {_p}
	set {replymessage::%{_s}'s uuid%} to {_p}
	set {replymessage::%{_p}'s uuid%} to {_s}

command w <player> <text>:
	prefix: core
	usage: {@usage} /<msg | w> &f<player> &f<message>
	aliases: w, whisper, msg
	trigger:
		msgPlayer(sender, arg 1, arg 2)

command whisper <player> <text>:
	prefix: core
	usage: {@usage} /<msg | w> &f<player> &f<message>
	aliases: w, whisper, msg
	trigger:
		msgPlayer(sender, arg 1, arg 2)

command msg <player> <text>:
	prefix: core
	usage: {@usage} /<msg | w> &f<player> &f<message>
	aliases: w, whisper, msg
	trigger:
		msgPlayer(sender, arg 1, arg 2)

command reply <text>:
	prefix: core
	usage: {@usage} /<reply | r> &f<message>
	aliases: r
	trigger:
		if {replymessage::%player's uuid%} is set:
			if {replymessage::%player's uuid%} is online:
				msgPlayer(sender, {replymessage::%sender's uuid%}, arg 1)
			else:
				send "{@warn} The recipient is offline."
				stop
		else:
			send "{@warn} No one to reply to! D:"

on leave:
	delete {replymessage::%player's uuid%}
