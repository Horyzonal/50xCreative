import:
    com.destroystokyo.paper.event.entity.PreCreatureSpawnEvent
    org.bukkit.entity.EntityType

on PreCreatureSpawnEvent:
    if event.getType().equals(EntityType.TEXT_DISPLAY) is true:
        event.setCancelled(true)

