command antiodedrug:
	permission: op
	trigger:
		give player armor stand named "&r&bNarcan" with lore "&8Right click to stop addiction/overdose today!"

on right click:
	if player's held item is armor stand named "&r&bNarcan" with lore "&8Right click to stop addiction/overdose today!":
		cancel event
		loop 2 times:
			play sound "block.beacon.power_select" with pitch 1.5 to player
			wait 10 ticks
		remove player's held item from player's inventory
		execute console command "effect clear %player%"
		delete {addiction::%player's uuid%}
		delete {startaddiction::%player's uuid%}
		delete {addictionactionbar::%player's uuid%}
		send "{@err} You have stopped your addiction. Please do not smoke again." to player

command solve:
	permission: op
	trigger:
		set {_x} to -21
		loop 41 times:
			make player say "%loop-value + {_x}%"